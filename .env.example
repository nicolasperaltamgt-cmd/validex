# Copiá este archivo como ".env.local" y completá los valores. NUNCA subas ".env.local" a internet.
# Hoy la app NO usa ninguno de estos valores: están listos para las próximas fases.

# --- Cuentas y guardados permanentes (Supabase) ---
# Se ven en: Supabase > Project Settings > API. Estas dos son públicas por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Datos reales (Mercado Libre, API oficial) ---
# Son SECRETOS: solo se usan en el servidor, jamás con el prefijo NEXT_PUBLIC_.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# ID de cliente de Google (público). Habilita el botón oficial de Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- El Importador con IA (preguntas libres) ---
# APAGADO por defecto. Se enciende SOLO con IMPORTADOR_IA=si Y una clave. Es un SECRETO del servidor: jamás con NEXT_PUBLIC_.
# OJO: Netlify inyecta una ANTHROPIC_API_KEY propia en sus sitios y la cobra de tus créditos; por eso la clave sola no enciende nada.
IMPORTADOR_IA=
# Cada pregunta libre cuesta plata en tu cuenta de Anthropic. Fijá un tope de gasto mensual en su panel.
ANTHROPIC_API_KEY=
# Modelo (opcional). Si no se pone, usa claude-opus-5-5. Para gastar mucho menos probá claude-haiku-5-5.
IMPORTADOR_MODELO=
# Máximo de preguntas con IA por día en todo el sitio (opcional, por defecto 200).
IMPORTADOR_MAX_DIA=

# --- Buscadores ---
# Por defecto el sitio NO se indexa (versión de prueba). Poné "si" al publicar cuando quieras que aparezca en Google.
NEXT_PUBLIC_INDEXAR=
