{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "noEmit": false,
    "incremental": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/meli.ts",
    "src/lib/meli-live.ts",
    "src/lib/dolar.ts"
  ]
}
